YOUTUBE_API_KEY=
# OAuth settings for authenticated V2 playlist tools. Tokens stay outside this repo.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8787/callback
# Optional private token-file override. Defaults to ~/.config/youtube-mcp/tokens.json.
YOUTUBE_TOKEN_FILE=
# Optional path to yt-dlp. Uses yt-dlp from PATH when omitted.
YT_DLP_PATH=
# Optional signed-in local browser session for yt-dlp caption discovery.
# Supported: chrome, chromium, firefox, edge, brave, opera, vivaldi.
# Cookies are read locally; no cookie export file is created.
YOUTUBE_COOKIES_BROWSER=
# Required when cookies are enabled: explicit dedicated browser profile directory.
YOUTUBE_COOKIES_PROFILE=
YOUTUBE_BROWSER_TRANSCRIPT_FALLBACK=false
# Optional public video used by pnpm smoke. Defaults to Rick Astley when omitted.
YOUTUBE_SMOKE_URL=
# Optional comments-enabled video. When omitted, comments-disabled is tolerated.
YOUTUBE_SMOKE_COMMENTS_URL=
# Optional caption-enabled video used by pnpm smoke to verify the transcript backend.
YOUTUBE_SMOKE_TRANSCRIPT_URL=
# Optional owned playlist used for an authenticated read-only smoke check.
YOUTUBE_SMOKE_OWNED_PLAYLIST_URL=
