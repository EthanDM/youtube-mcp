YOUTUBE_API_KEY=
# Optional path to yt-dlp. Uses yt-dlp from PATH when omitted.
YT_DLP_PATH=
# Optional public video used by pnpm smoke. Defaults to Rick Astley when omitted.
YOUTUBE_SMOKE_URL=
# Optional comments-enabled video. When omitted, comments-disabled is tolerated.
YOUTUBE_SMOKE_COMMENTS_URL=
# Optional caption-enabled video used by pnpm smoke to verify the transcript backend.
YOUTUBE_SMOKE_TRANSCRIPT_URL=
